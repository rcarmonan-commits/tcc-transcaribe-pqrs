# Copie este archivo como .env y cambie los tres valores marcados CAMBIAR.
# El archivo .env está en .gitignore: no debe versionarse nunca.

# --- Base de datos ---
DB_NOMBRE=transcaribe_pqrs
DB_USUARIO=transcaribe
DB_CONTRASENA=CAMBIAR_por_una_contrasena_fuerte

# --- Firma de los testigos JWT ---
# CAMBIAR. Mínimo 32 caracteres. Genérela con:
#   openssl rand -base64 48
JWT_SECRET=CAMBIAR_clave_de_firma_de_al_menos_32_caracteres

# --- Exposición del servicio ---
PUERTO=8080
PERFIL=prod
CORS_ORIGENES=http://localhost:4200
RATE_LIMIT_POR_MINUTO=60
