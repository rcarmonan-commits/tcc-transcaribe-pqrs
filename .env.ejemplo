# No hace falta copiar este archivo a mano: `scripts/arrancar.ps1 -Modo docker`
# genera el `.env` con credenciales nuevas para la máquina donde corre. Esto
# queda como referencia de qué significa cada variable.
#
# Si prefiere hacerlo a mano: copie este archivo como .env y cambie los valores
# marcados CAMBIAR. El archivo .env está en .gitignore y no se versiona nunca.

# --- Base de datos ---
DB_NOMBRE=transcaribe_pqrs
DB_USUARIO=transcaribe
DB_CONTRASENA=CAMBIAR_por_una_contrasena_fuerte

# --- Firma de los testigos JWT ---
# CAMBIAR. Mínimo 32 caracteres. Genérela con:
#   openssl rand -base64 48
JWT_SECRET=CAMBIAR_clave_de_firma_de_al_menos_32_caracteres

# --- Exposición del servicio ---
PUERTO=8080

# --- Perfil de ejecución ---
# dev  carga el esquema MÁS los datos de demostración: tres cuentas, rutas,
#      vehículos y catálogos. Es lo que se quiere para ver el sistema andando.
# prod carga solo el esquema, sin ninguna cuenta. Entonces la primera hay que
#      crearla desde el entorno, con ADMIN_USUARIO, ADMIN_CORREO y
#      ADMIN_CONTRASENA; sin ellas el servicio arranca pero nadie puede entrar.
PERFIL=dev

CORS_ORIGENES=http://localhost:4200
RATE_LIMIT_POR_MINUTO=60
