              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placaVehiculo\": \"UXT101\",\n  \"codigoRuta\": \"T100\",\n  \"tipoIncidencia\": \"RETRASO\",\n  \"descripcion\": \"El vehículo acumuló cuarenta minutos de retraso por congestión en la troncal.\",\n  \"fechaHora\": \"2026-03-04T07:45:00\",\n  \"radicadoAsociado\": \"{{radicado}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/incidencias", "host": ["{{baseUrl}}"], "path": ["api", "v1", "incidencias"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const cuerpo = pm.response.json();",
                  "pm.collectionVariables.set('consecutivoIncidencia', cuerpo.consecutivo);",
                  "pm.test('Nace reportada', () => pm.expect(cuerpo.estado).to.eql('REPORTADA'));",
                  "pm.test('Queda vinculada a la solicitud del ciudadano', () => {",
                  "    pm.expect(cuerpo.radicadoAsociado).to.eql(pm.collectionVariables.get('radicado'));",
                  "});",
                  "pm.test('Hereda la prioridad de su tipo', () => pm.expect(cuerpo.prioridad).to.eql('MEDIA'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Incidencia fechada en el futuro (debe rechazarse)",
